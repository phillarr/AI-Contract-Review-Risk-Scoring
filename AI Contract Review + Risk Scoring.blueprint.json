        {
            "id": 14,
            "module": "google-docs:createADocumentFromTemplate",
            "version": 1,
            "parameters": {
                "__IMTCONN__": null
            },
            "mapper": {
                "from": "drive",
                "name": "{{15.title}}",
                "select": "dropdown",
                "document": "/YOUR_TEMPLATE_DOCUMENT_ID",
                "folderId": "/YOUR_FOLDER_ID",
                "requests": {
                    "title": "{{15.title}}",
                    "clauses": "{{15.clauses_text}}",
                    "parties": "{{join(map(15.parties; \"name\"); \", \")}}",
                    "contract_id": "{{15.contract_id}}",
                    "effective_date": "{{15.effective_date}}",
                    "expiration_date": "{{15.expiration_date}}",
                    "executive_summary": "{{15.executive_summary}}",
                    "overall_risk_score": "{{15.overall_risk_score}}"
                },
                "destination": "drive"
            },
            "metadata": {
                "designer": {
                    "x": 1500,
                    "y": 0
                },
                "restore": {
                    "expect": {
                        "from": {
                            "label": "My Drive"
                        },
                        "select": {
                            "label": "By Dropdown"
                        },
                        "document": {
                            "path": [
                                "Templates",
                                "contract_risk_report_template"
                            ]
                        },
                        "folderId": {
                            "mode": "chose",
                            "path": [
                                "Reports"
                            ]
                        },
                        "destination": {
                            "label": "My Drive"
                        }
                    },
                    "parameters": {
