                            ]
                        }
                    },
                    {
                        "name": "document",
                        "type": "file",
                        "label": "Document ID",
                        "required": true
                    },
                    {
                        "name": "requests",
                        "spec": [
                            {
                                "name": "title",
                                "type": "any"
                            },
                            {
                                "name": "contract_id",
                                "type": "any"
                            },
                            {
                                "name": "parties",
                                "type": "any"
                            },
                            {
                                "name": "effective_date",
