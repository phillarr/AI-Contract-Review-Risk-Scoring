            "mapper": {
                "data": "{{11.data}}",
                "imageSendMethod": "send_type_data",
                "isToOptimizeDetection": true,
                "isToIncludeFullTextAnnotation": false
            },
            "metadata": {
                "designer": {
                    "x": 600,
                    "y": 0
                },
                "restore": {
                    "expect": {
                        "imageSendMethod": {
                            "label": "Data"
                        }
                    },
                    "parameters": {
                        "__IMTCONN__": {
                            "data": {
                                "scoped": "true",
                                "connection": "googlecloudvision"
                            },
                            "label": "My Google Cloud Vision connection"
